# URL của Medusa backend (xem backend/.env sau khi scaffold)
MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API Key — lấy trong Medusa Admin: Settings > Publishable API Keys
# (bắt buộc để gọi Store API, tạo sau khi backend chạy lần đầu)
MEDUSA_PUBLISHABLE_KEY=

# Google Analytics 4 Measurement ID (dạng G-XXXXXXXXXX) — để trống nếu chưa có, tag sẽ không được chèn vào trang.
PUBLIC_GA_ID=
