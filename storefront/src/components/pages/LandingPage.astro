---
import Layout from "../Layout.astro";
import { formatPrice } from "../../lib/format";
import { getAllProducts, toCatalogItem } from "../../lib/medusa";
import { site } from "../../lib/site";
import { localizePath, t, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const L = (p: string) => localizePath(locale, p);

const products = await getAllProducts();
const items = products.map((p) => toCatalogItem(p, locale)).filter((i) => i.thumbnail);

const hero = items[0];
const bento = items.slice(1, 6);
const onSale = items.filter((i) => i.onSale).slice(0, 5);

function pct(item: (typeof items)[number]) {
  return item.onSale && item.wasPrice && item.price ? Math.round((1 - item.price / item.wasPrice) * 100) : null;
}

// Placeholder: 4 video công khai về skincare cơ bản, dùng tạm cho tới khi có video thật của shop.
// Thay youtubeId bằng video riêng của JLP khi có — xem storefront/src/components/pages/LandingPage.astro.
const BEAUTY_VIDEOS = [
  { youtubeId: "MihWtTw3Lk4", title: { vi: "5 bước skincare cơ bản chuẩn khoa học", en: "5 basic science-backed skincare steps", ja: "科学的根拠に基づく基本の5ステップスキンケア" } },
  { youtubeId: "qf61jB25vaU", title: { vi: "Các bước skincare cho người mới bắt đầu", en: "Skincare steps for beginners", ja: "初心者向けスキンケアの手順" } },
  { youtubeId: "bagoKirS9Rc", title: { vi: "Cách bôi kem chống nắng đúng chuẩn", en: "How to apply sunscreen correctly", ja: "日焼け止めの正しい塗り方" } },
  { youtubeId: "DbrpEDtyIHE", title: { vi: "Có cần tẩy trang trước khi bôi lại kem chống nắng?", en: "Do you need to remove makeup before reapplying sunscreen?", ja: "日焼け止めを塗り直す前にクレンジングは必要?" } },
] as const;

const COPY = {
  vi: {
    heroEyebrow: "Hàng nội địa Nhật · Nhập chính ngạch",
    heroTitleTop: "Mỹ phẩm Nhật,",
    heroTitleBottom: "tra cứu được nguồn gốc.",
    lede: "Mọi sản phẩm đều có mã JAN và số phiếu công bố để bạn tự đối chiếu — không phải hàng xách tay không rõ nguồn gốc.",
    ctaShop: "Xem catalog →",
    ctaZalo: "Chat Zalo",
    promise: "💬 Phản hồi trong ~15 phút giờ hành chính",
    bestSeller: "✨ Bán chạy",
    marquee: ["✦ HÀNG CHÍNH NGẠCH", "✦ TRA ĐƯỢC MÃ JAN", "✦ GIAO NHANH NỘI THÀNH", "✦ ĐỔI HÀNG 7 NGÀY", "✦ ĐẶT HÀNG QUA ZALO"],
    productsEyebrow: "Sản phẩm",
    productsTitle: "Được yêu thích nhất",
    beautyNote: "Video tham khảo — nội dung sẽ được cập nhật bằng video hướng dẫn riêng của shop.",
    whyEyebrow: (name: string) => `Vì sao chọn ${name}`,
    whyTitle: "Không phải hàng xách tay không rõ nguồn gốc",
    why1t: "Đối chiếu mã JAN thật", why1: "Kiểm tra trực tiếp với mã in trên vỏ hộp",
    why2t: "Số phiếu công bố chính thức", why2: "Tra cứu trên cổng thông tin của Cục Quản lý Dược",
    why3t: "Giao hàng 1–2 ngày", why3: "Giao nội thành, đóng gói cẩn thận",
    why4t: "Tư vấn qua Zalo", why4: "Được tư vấn đúng loại da, đúng nhu cầu",
    dealsEyebrow: "Ưu đãi",
    dealsTitle: "Đang khuyến mãi",
    finalTitle: "Sẵn sàng khám phá?",
    finalBody: "Xem toàn bộ catalog, lọc theo danh mục và khuyến mãi trên trang chính.",
    finalCta: "Vào cửa hàng →",
    footer: "Website trưng bày sản phẩm — đặt hàng qua Zalo hoặc điện thoại",
    metaDesc: "Mỹ phẩm nội địa Nhật nhập chính ngạch, tra được mã JAN và số phiếu công bố. Đặt hàng qua Zalo hoặc điện thoại, giao 1–2 ngày nội thành.",
  },
  en: {
    heroEyebrow: "Japanese domestic goods · Officially imported",
    heroTitleTop: "Japanese cosmetics,",
    heroTitleBottom: "traceable to the source.",
    lede: "Every product carries a JAN code and an official registration number so you can verify it yourself — not unverifiable grey-market goods.",
    ctaShop: "Browse catalog →",
    ctaZalo: "Chat on Zalo",
    promise: "💬 We reply within ~15 minutes during business hours",
    bestSeller: "✨ Best seller",
    marquee: ["✦ OFFICIALLY IMPORTED", "✦ VERIFIABLE JAN CODE", "✦ FAST LOCAL DELIVERY", "✦ 7-DAY EXCHANGE", "✦ ORDER VIA ZALO"],
    productsEyebrow: "Products",
    productsTitle: "Customer favorites",
    beautyNote: "Reference videos — will be replaced with the shop's own tutorials.",
    whyEyebrow: (name: string) => `Why choose ${name}`,
    whyTitle: "Not unverifiable grey-market goods",
    why1t: "Verify the real JAN code", why1: "Check it directly against the code printed on the box",
    why2t: "Official registration number", why2: "Looked up on the Drug Administration's own portal",
    why3t: "1–2 day delivery", why3: "Local delivery, carefully packaged",
    why4t: "Zalo advice", why4: "Get matched to the right skin type and needs",
    dealsEyebrow: "Deals",
    dealsTitle: "On sale now",
    finalTitle: "Ready to explore?",
    finalBody: "Browse the full catalog, filter by category and promotions on the main site.",
    finalCta: "Go to the shop →",
    footer: "This site only showcases products — order via Zalo or phone",
    metaDesc: "Genuine Japanese domestic cosmetics, officially imported, with verifiable JAN codes and license numbers. Order via Zalo or phone, 1–2 day local delivery.",
  },
  ja: {
    heroEyebrow: "日本製・正規輸入品",
    heroTitleTop: "日本製化粧品、",
    heroTitleBottom: "産地まで確認できる。",
    lede: "すべての商品にJANコードと届出番号があり、ご自身で確認いただけます — 出所不明の並行輸入品ではありません。",
    ctaShop: "カタログを見る →",
    ctaZalo: "Zaloでチャット",
    promise: "💬 営業時間内は約15分以内に返信します",
    bestSeller: "✨ 人気商品",
    marquee: ["✦ 正規輸入品", "✦ JANコードで確認可能", "✦ 市内配送が早い", "✦ 7日以内交換", "✦ Zaloでご注文"],
    productsEyebrow: "商品",
    productsTitle: "人気の商品",
    beautyNote: "参考動画です — 今後、当店オリジナルの動画に差し替え予定です。",
    whyEyebrow: (name: string) => `${name}を選ぶ理由`,
    whyTitle: "出所不明の並行輸入品ではありません",
    why1t: "本物のJANコードを確認", why1: "箱に印刷されたコードと直接照合できます",
    why2t: "正式な届出番号", why2: "薬務管理局のポータルで確認できます",
    why3t: "1〜2日でお届け", why3: "市内配送、丁寧に梱包",
    why4t: "Zaloでご相談", why4: "肌タイプやニーズに合わせてご案内",
    dealsEyebrow: "セール",
    dealsTitle: "キャンペーン中",
    finalTitle: "見てみませんか?",
    finalBody: "カタログ全体をご覧いただき、カテゴリーやキャンペーンで絞り込めます。",
    finalCta: "ショップへ →",
    footer: "本サイトは商品展示のみ — ご注文はZaloまたはお電話で",
    metaDesc: "正規輸入の日本製化粧品。JANコードと届出番号で確認可能。ご注文はZaloまたはお電話で、市内1〜2日でお届け。",
  },
} as const;


const c = COPY[locale];
---

<Layout locale={locale} title={`${site.name} — ${c.heroTitleTop} ${c.heroTitleBottom}`} description={c.metaDesc} image={hero?.thumbnail}>
  <section class="lp-hero">
    <div class="wrap lp-hero-grid">
      <div>
        <p class="lp-eyebrow">{c.heroEyebrow}</p>
        <h1>
          {c.heroTitleTop}
          <br />
          <em>{c.heroTitleBottom}</em>
        </h1>
        <p class="lede">{c.lede}</p>
        <div class="cta-row">
          <a class="lp-btn primary" href={L("/shop/")}>{c.ctaShop}</a>
          <a class="lp-btn ghost" href={site.zaloUrl} target="_blank" rel="noopener">{c.ctaZalo}</a>
        </div>
        <p class="lp-promise">{c.promise}</p>
      </div>
      <div class="lp-tilt-wrap">
        <div class="lp-tilt" id="tilt-card">
          {hero?.thumbnail && <img src={hero.thumbnail} alt={hero.title} />}
          <span class="badge">{c.bestSeller}</span>
          {hero && (
            <div class="price-tag">
              {hero.brand && <span class="b">{hero.brand}</span>}
              <span class="n">{hero.title}</span>
              {hero.price != null && <span class="p">{formatPrice(hero.price, hero.currency)}</span>}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <div class="lp-marquee-wrap">
    <div class="lp-marquee">
      {Array.from({ length: 2 }).map(() => (
        <>
          {c.marquee.map((m) => (
            <span>{m}</span>
          ))}
        </>
      ))}
    </div>
  </div>

  <section class="lp-section">
    <div class="wrap">
      <div class="lp-head lp-reveal">
        <p class="lp-eyebrow2">{c.productsEyebrow}</p>
        <h2>{c.productsTitle}</h2>
      </div>
      <div class="lp-bento feature lp-reveal">
        {bento.map((item) => (
          <a class="lp-card" href={L(`/products/${item.handle}/`)}>
            <div class="media">
              {pct(item) && <span class="pct-badge">-{pct(item)}%</span>}
              {item.gift && <span class="gift-badge">🎁</span>}
              {item.thumbnail && <img src={item.thumbnail} alt={item.title} />}
            </div>
            <div class="info">
              {item.brand && <p class="brand">{item.brand}</p>}
              <p class="name">{item.title}</p>
              <p class="prices">
                {item.price != null && <span class="now">{formatPrice(item.price, item.currency)}</span>}
                {item.wasPrice != null && <span class="was">{formatPrice(item.wasPrice, item.currency)}</span>}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="lp-section" style="background:var(--card)">
    <div class="wrap">
      <div class="lp-head lp-reveal">
        <p class="lp-eyebrow2">{dict.beautyTipsEyebrow}</p>
        <h2>{dict.beautyTipsTitle}</h2>
      </div>
      <div class="lp-video-carousel lp-reveal">
        <button type="button" class="lp-vc-nav prev" aria-label="Previous">‹</button>
        <div class="lp-vc-track" id="lp-video-track">
          {BEAUTY_VIDEOS.map((v) => (
            <div class="lp-vc-item">
              <div class="lp-vc-frame">
                <iframe
                  src={`https://www.youtube.com/embed/${v.youtubeId}`}
                  title={v.title[locale]}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
              <p class="lp-vc-caption">{v.title[locale]}</p>
            </div>
          ))}
        </div>
        <button type="button" class="lp-vc-nav next" aria-label="Next">›</button>
      </div>
      <p class="lp-vc-note">{c.beautyNote}</p>
    </div>
  </section>

  <section class="lp-section">
    <div class="wrap">
      <div class="lp-head lp-reveal">
        <p class="lp-eyebrow2">{c.whyEyebrow(site.name)}</p>
        <h2>{c.whyTitle}</h2>
      </div>
      <div class="lp-why lp-reveal">
        <div class="lp-why-item"><div class="icn">🔎</div><h3>{c.why1t}</h3><p>{c.why1}</p></div>
        <div class="lp-why-item"><div class="icn">📄</div><h3>{c.why2t}</h3><p>{c.why2}</p></div>
        <div class="lp-why-item"><div class="icn">🚚</div><h3>{c.why3t}</h3><p>{c.why3}</p></div>
        <div class="lp-why-item"><div class="icn">💬</div><h3>{c.why4t}</h3><p>{c.why4}</p></div>
      </div>
    </div>
  </section>

  {onSale.length > 0 && (
    <section class="lp-section" style="background:var(--card)">
      <div class="wrap">
        <div class="lp-head lp-reveal">
          <p class="lp-eyebrow2">{c.dealsEyebrow}</p>
          <h2>{c.dealsTitle}</h2>
        </div>
        <div class="lp-bento lp-reveal" style="grid-auto-rows:260px">
          {onSale.map((item) => (
            <a class="lp-card" href={L(`/products/${item.handle}/`)}>
              <div class="media">
                {pct(item) && <span class="pct-badge">-{pct(item)}%</span>}
                {item.gift && <span class="gift-badge">🎁</span>}
                {item.thumbnail && <img src={item.thumbnail} alt={item.title} />}
              </div>
              <div class="info">
                {item.brand && <p class="brand">{item.brand}</p>}
                <p class="name">{item.title}</p>
                <p class="prices">
                  {item.price != null && <span class="now">{formatPrice(item.price, item.currency)}</span>}
                  {item.wasPrice != null && <span class="was">{formatPrice(item.wasPrice, item.currency)}</span>}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="lp-section">
    <div class="wrap">
      <div class="lp-final lp-reveal">
        <h2>{c.finalTitle}</h2>
        <p>{c.finalBody}</p>
        <a class="lp-btn primary" href={L("/shop/")}>{c.finalCta}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .lp-hero {
    position: relative;
    min-height: 72vh;
    display: flex;
    align-items: center;
    background:
      radial-gradient(circle at 12% 15%, #fbe3d8 0%, transparent 42%),
      radial-gradient(circle at 88% 10%, #f6d9e0 0%, transparent 40%),
      radial-gradient(circle at 50% 100%, #fef3e7 0%, transparent 55%),
      var(--paper);
    overflow: hidden;
    border-radius: var(--radius);
  }
  .lp-hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items: center; padding: 3rem 0; }
  .lp-eyebrow { font-family: var(--font-label, monospace); font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--beni, #b0303c); }
  .lp-hero h1 { color: var(--ink); font-size: clamp(2.2rem, 5vw, 3.8rem); margin: 0.6rem 0 1.2rem; font-family: var(--font-display, serif); font-weight: 600; line-height: 1.08; }
  .lp-hero em { font-style: italic; color: var(--beni, #b0303c); }
  .lp-hero .lede { font-size: 1.1rem; color: var(--ink-soft); max-width: 42ch; margin: 0 0 2rem; }
  .lp-hero .cta-row { display: flex; gap: 1rem; flex-wrap: wrap; }
  .lp-promise { font-size: 0.85rem; color: var(--seal, #2f6551); margin: 1rem 0 0; }

  .lp-btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.9rem 1.6rem; border-radius: 999px; font-weight: 600; font-size: 0.95rem; text-decoration: none; transition: transform 0.2s; }
  .lp-btn:hover { transform: translateY(-2px); }
  .lp-btn.primary { background: var(--beni, #b0303c); color: #fff; }
  .lp-btn.ghost { border: 1px solid var(--ink); color: var(--ink); }

  .lp-tilt-wrap { perspective: 1200px; }
  .lp-tilt { position: relative; border-radius: 18px; overflow: hidden; aspect-ratio: 4/5; box-shadow: 0 30px 60px rgba(176,48,60,.18), 0 10px 25px rgba(20,33,58,.12); transition: transform .15s ease-out; background: var(--card); }
  .lp-tilt img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lp-tilt .badge { position: absolute; top: 1rem; left: 1rem; background: #fff; color: var(--beni, #b0303c); font-family: var(--font-label, monospace); font-size: 0.75rem; font-weight: 700; padding: 0.35rem 0.7rem; border-radius: 999px; box-shadow: 0 4px 12px rgba(0,0,0,.1); }
  .lp-tilt .price-tag { position: absolute; bottom: 1rem; left: 1rem; right: 1rem; background: rgba(255,255,255,.92); backdrop-filter: blur(4px); border-radius: 12px; padding: .7rem .9rem; display: flex; flex-direction: column; gap: .1rem; }
  .lp-tilt .price-tag .b { font-family: var(--font-label, monospace); font-size: .68rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ochre, #8a7551); }
  .lp-tilt .price-tag .n { font-size: .92rem; font-weight: 600; color: var(--ink); }
  .lp-tilt .price-tag .p { font-family: var(--font-label, monospace); font-weight: 700; color: var(--beni, #b0303c); font-size: 1.05rem; }

  .lp-marquee-wrap { background: var(--beni-wash, #fdeceb); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); overflow: hidden; padding: 1rem 0; margin-top: 1.5rem; }
  .lp-marquee { display: flex; gap: 3rem; width: max-content; animation: lpScroll 24s linear infinite; }
  .lp-marquee span { color: var(--beni, #b0303c); font-family: var(--font-label, monospace); font-weight: 600; font-size: 0.85rem; letter-spacing: 0.05em; white-space: nowrap; }
  @keyframes lpScroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .lp-marquee { animation: none; } }

  .lp-section { padding: clamp(2.5rem, 6vw, 4.5rem) 0; }
  .lp-head { text-align: center; max-width: 46ch; margin: 0 auto 2.5rem; }
  .lp-head .lp-eyebrow2 { font-family: var(--font-label, monospace); font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ochre, #8a7551); }
  .lp-head h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin: 0.5rem 0 0; font-family: var(--font-display, serif); font-weight: 600; }

  .lp-bento { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 220px; grid-auto-flow: dense; gap: 1.1rem; }
  .lp-card { position: relative; border-radius: 16px; overflow: hidden; background: var(--card); box-shadow: 0 2px 10px rgba(20,33,58,.06); transition: transform .3s ease, box-shadow .3s ease; display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  .lp-card:hover { transform: translateY(-6px); box-shadow: 0 18px 32px rgba(176,48,60,.16); }
  .lp-bento.feature .lp-card:first-child { grid-column: span 2; grid-row: span 2; }
  .lp-card .media { position: relative; flex: 1; overflow: hidden; background: var(--paper); }
  .lp-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lp-card .pct-badge { position: absolute; top: .6rem; left: .6rem; background: var(--beni, #b0303c); color: #fff; font-family: var(--font-label, monospace); font-size: .7rem; font-weight: 700; padding: .25rem .5rem; border-radius: 999px; z-index: 1; }
  .lp-card .gift-badge { position: absolute; top: .6rem; right: .6rem; background: var(--seal, #2f6551); color: #fff; font-family: var(--font-label, monospace); font-size: .65rem; font-weight: 700; padding: .25rem .5rem; border-radius: 999px; z-index: 1; }
  .lp-card .info { padding: .7rem .8rem .85rem; }
  .lp-card .brand { font-family: var(--font-label, monospace); font-size: .65rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ochre, #8a7551); margin: 0 0 .15rem; }
  .lp-card .name { font-size: .85rem; font-weight: 600; margin: 0 0 .3rem; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .lp-card:first-child .name { -webkit-line-clamp: 2; font-size: 1rem; }
  .lp-card .prices { display: flex; align-items: baseline; gap: .4rem; font-family: var(--font-label, monospace); }
  .lp-card .now { color: var(--beni, #b0303c); font-weight: 700; font-size: .88rem; }
  .lp-card .was { color: #9aa3b4; font-size: .72rem; text-decoration: line-through; }
  @media (max-width: 800px) { .lp-bento { grid-template-columns: repeat(2, 1fr); } .lp-card:first-child { grid-column: span 2; } }

  .lp-reveal { opacity: 0; transform: translateY(24px); transition: opacity .6s ease, transform .6s ease; }
  .lp-reveal.in { opacity: 1; transform: translateY(0); }

  /* carousel video hướng dẫn làm đẹp */
  .lp-video-carousel { position: relative; display: flex; align-items: center; gap: .5rem; }
  .lp-vc-track { display: flex; gap: 1.1rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; padding: .25rem; flex: 1; }
  .lp-vc-track::-webkit-scrollbar { display: none; }
  .lp-vc-item { scroll-snap-align: start; flex: 0 0 min(320px, 78vw); }
  .lp-vc-frame { position: relative; aspect-ratio: 9/16; border-radius: 14px; overflow: hidden; background: #000; box-shadow: 0 2px 10px rgba(20,33,58,.1); }
  .lp-vc-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .lp-vc-caption { margin: .6rem 0 0; font-size: .85rem; color: var(--ink-soft); text-align: center; }
  .lp-vc-nav { flex: none; width: 2.4rem; height: 2.4rem; border-radius: 50%; border: 1px solid var(--rule); background: var(--card); font-size: 1.4rem; line-height: 1; cursor: pointer; color: var(--ink); }
  .lp-vc-nav:hover { background: var(--paper); }
  .lp-vc-note { text-align: center; font-size: .78rem; color: var(--ink-faint); margin: 1rem 0 0; }
  @media (max-width: 640px) { .lp-vc-nav { display: none; } }

  .lp-why { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .lp-why-item { text-align: center; padding: 1.5rem 1rem; border-radius: 14px; background: var(--card); box-shadow: 0 2px 10px rgba(20,33,58,.05); }
  .lp-why-item .icn { font-size: 2rem; margin-bottom: 0.75rem; }
  .lp-why-item h3 { font-size: 1.05rem; margin: 0 0 0.4rem; font-family: var(--font-display, serif); }
  .lp-why-item p { margin: 0; font-size: 0.88rem; color: var(--ink-soft); }
  @media (max-width: 800px) { .lp-why { grid-template-columns: repeat(2, 1fr); } }

  .lp-final { position: relative; border-radius: 20px; overflow: hidden; padding: clamp(3rem, 6vw, 5rem) 2rem; text-align: center; background: radial-gradient(circle at 25% 25%, #fbe3d8 0%, transparent 50%), radial-gradient(circle at 80% 80%, #f6d9e0 0%, transparent 45%), var(--card); border: 1px solid var(--rule); }
  .lp-final h2 { color: var(--ink); font-size: clamp(1.6rem, 3.6vw, 2.4rem); margin-bottom: 1rem; font-family: var(--font-display, serif); font-weight: 600; }
  .lp-final p { color: var(--ink-soft); margin: 0 0 2rem; }

  @media (max-width: 900px) { .lp-hero-grid { grid-template-columns: 1fr; } .lp-tilt { max-width: 320px; margin: 0 auto; } }
</style>

<script>
  const tilt = document.getElementById("tilt-card");
  if (tilt) {
    tilt.addEventListener("mousemove", (e) => {
      const r = tilt.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      (tilt as HTMLElement).style.transform = `rotateY(${x * 14}deg) rotateX(${-y * 14}deg)`;
    });
    tilt.addEventListener("mouseleave", () => {
      (tilt as HTMLElement).style.transform = "rotateY(0) rotateX(0)";
    });
  }

  const revealEls = document.querySelectorAll(".lp-reveal");
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("in");
          io.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.15 },
  );
  revealEls.forEach((el) => io.observe(el));

  const track = document.getElementById("lp-video-track");
  const prevBtn = document.querySelector(".lp-vc-nav.prev");
  const nextBtn = document.querySelector(".lp-vc-nav.next");
  if (track && prevBtn && nextBtn) {
    const scrollByCard = (dir: number) => {
      const card = track.querySelector(".lp-vc-item") as HTMLElement | null;
      const amount = card ? card.getBoundingClientRect().width + 18 : 320;
      track.scrollBy({ left: dir * amount, behavior: "smooth" });
    };
    prevBtn.addEventListener("click", () => scrollByCard(-1));
    nextBtn.addEventListener("click", () => scrollByCard(1));
  }
</script>
