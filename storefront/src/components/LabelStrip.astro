---
import { barcode } from "../lib/format";
import type { CatalogItem } from "../lib/medusa";
import type { Locale } from "../i18n";

interface Props {
  item: CatalogItem;
  full?: boolean;
  locale?: Locale;
}
const { item, full = false, locale = "vi" as Locale } = Astro.props;
const L = {
  vi: { volume: "Dung tích", origin: "Xuất xứ", lot: "Lô", cbmp: "Phiếu công bố" },
  en: { volume: "Volume", origin: "Origin", lot: "Batch", cbmp: "License no." },
  ja: { volume: "内容量", origin: "原産地", lot: "ロット", cbmp: "届出番号" },
}[locale];
---

<div class={`strip${full ? " full" : ""}`}>
  {
    item.jan && (
      <div class="barcode" aria-hidden="true" set:html={barcode(item.jan)} />
    )
  }
  <dl class="fields">
    {item.volume && (<div class="field"><dt>{L.volume}</dt><dd>{item.volume}</dd></div>)}
    {item.origin && (<div class="field"><dt>{L.origin}</dt><dd>{item.origin}</dd></div>)}
    {item.jan && (<div class="field"><dt>JAN</dt><dd>{item.jan}</dd></div>)}
    {full && item.lot && (<div class="field"><dt>{L.lot}</dt><dd>{item.lot}</dd></div>)}
    {full && item.cbmp && (
      <div class="field verified">
        <dt>{L.cbmp}</dt>
        <dd>
          <svg viewBox="0 0 16 16" width="11" height="11">
            <path d="M5 8.2l2 2L11.2 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {item.cbmp}
        </dd>
      </div>
    )}
  </dl>
</div>
