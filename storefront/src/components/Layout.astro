---
import "../styles/global.css";
import { site } from "../lib/site";
import { getCategories } from "../lib/medusa";
import { locales, localizePath, stripLocalePrefix, t, translateCategoryName, categoryIcon, type Locale } from "../i18n";

interface Props {
  title: string;
  description?: string;
  image?: string | null;
  locale?: Locale;
}
const { title, description = site.tagline, image, locale = "vi" as Locale } = Astro.props;
const dict = t(locale);
const categories = await getCategories();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://example.com");
const gaId = import.meta.env.PUBLIC_GA_ID as string | undefined;
const basePath = stripLocalePrefix(Astro.url.pathname);
const alternates = locales.map((l) => ({ locale: l, href: localizePath(l, basePath) }));
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.locale} href={new URL(a.href, canonicalUrl.origin)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localizePath("vi", basePath), canonicalUrl.origin)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      name: site.name,
      image,
      telephone: site.phone,
      email: site.email,
      address: { "@type": "PostalAddress", streetAddress: site.address, addressCountry: "VN" },
      openingHours: site.hours,
      url: canonicalUrl.origin,
    })} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,400..600,0..100,0..1&family=Be+Vietnam+Pro:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Set theme trước khi CSS/paint để tránh nhấp nháy sáng→tối lúc tải trang.
      (function () {
        const saved = localStorage.getItem("theme");
        const theme = saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        if (theme === "dark") document.documentElement.dataset.theme = "dark";
      })();
    </script>
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag("js", new Date());
          gtag("config", gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <div class="utility">
      <div class="wrap">
        <span>📞 {dict.hotline} {site.phone}</span>
        <span>{dict.deliveryNote}</span>
      </div>
    </div>

    <header class="hdr">
      <div class="wrap bar">
        <a class="logo" href={localizePath(locale, "/")}><span class="mark">{site.name}</span><span class="ja">{site.nameJa}</span></a>

        <div class="search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          <input type="text" id="site-search" placeholder={dict.searchPlaceholder} autocomplete="off" data-locale={locale} data-search-empty={dict.searchEmpty("{q}")} />
          <div id="search-results" class="search-results" hidden></div>
        </div>

        <div class="hdr-tools">
          <div class="lang-switch">
            <button type="button" id="lang-btn" aria-haspopup="true" aria-expanded="false">🌐 <span id="lang-current">{locale.toUpperCase()}</span></button>
            <ul id="lang-menu" hidden>
              <li><a href={localizePath("vi", basePath)} aria-current={locale === "vi" ? "true" : undefined}>Tiếng Việt</a></li>
              <li><a href={localizePath("en", basePath)} aria-current={locale === "en" ? "true" : undefined}>English</a></li>
              <li><a href={localizePath("ja", basePath)} aria-current={locale === "ja" ? "true" : undefined}>日本語</a></li>
            </ul>
          </div>
          <button type="button" id="theme-toggle" aria-label={dict.themeToggle}>
            <svg id="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><path d="M12 2v2M12 20v2M4 12H2M22 12h-2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <svg id="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" hidden><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z" stroke="currentColor" stroke-width="1.6"/></svg>
          </button>
          <a class="hdr-cta" href={site.zaloUrl} target="_blank" rel="noopener">{dict.chatZalo}</a>
        </div>
      </div>
    </header>

    <nav class="catstrip">
      <div class="wrap">
        <a href={localizePath(locale, "/shop/")}><span class="ic">🛍️</span>{dict.shopAll}</a>
        {categories.map((c) => (
          <a href={localizePath(locale, `/categories/${c.handle}/`)}><span class="ic">{categoryIcon(c.name)}</span>{translateCategoryName(c.name, locale)}</a>
        ))}
        <a href={localizePath(locale, "/promotions/")}><span class="ic">🎁</span>{dict.promotions}</a>
        <a href={`${localizePath(locale, "/shop/")}#new-arrivals`}><span class="ic">✨</span>{dict.newArrivals}</a>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="ftr">
      <div class="wrap cols">
        <div>
          <p class="eyebrow">{dict.contact}</p>
          <p>{site.phone}<br />{site.email}</p>
          <p class="note">{site.address}<br />{site.hours}</p>
        </div>
        <div>
          <p class="eyebrow">{dict.categoriesLabel}</p>
          <p class="note">
            {categories.map((c, i) => (
              <>
                <a href={localizePath(locale, `/categories/${c.handle}/`)}>{translateCategoryName(c.name, locale)}</a>
                {i < categories.length - 1 ? " · " : ""}
              </>
            ))}
          </p>
        </div>
        <div>
          <p class="eyebrow">{dict.aboutGoods}</p>
          <p class="note">
            {dict.aboutGoodsBody}
            <br /><a href={localizePath(locale, "/about/")}>{dict.aboutGoodsLink}</a>
          </p>
        </div>
      </div>
      <div class="wrap fine data">
        <span>{dict.footerCopyright(new Date().getFullYear())} {site.name}</span>
        <span>{dict.footerShowcaseNote}</span>
        <span><a href={localizePath(locale, "/faq/")}>{dict.faq}</a> · <a href={localizePath(locale, "/privacy-policy/")}>{dict.privacyPolicy}</a></span>
      </div>
    </footer>

    <div class="dock">
      <span class="response-promise">{dict.responsePromise}</span>
      <a class="z" href={site.zaloUrl} target="_blank" rel="noopener">{dict.chatZalo}</a>
      <a class="c" href={site.phoneHref}>{site.phone}</a>
    </div>

    <nav class="mnav">
      <div class="wrap row">
        <a href={localizePath(locale, "/")}><span class="icn">🏠</span>{dict.home}</a>
        <a href={`${localizePath(locale, "/shop/")}#categories`}><span class="icn">📂</span>{dict.categories}</a>
        <a href={localizePath(locale, "/promotions/")}><span class="icn">🎁</span>{dict.promotions}</a>
        <a href={site.zaloUrl} target="_blank" rel="noopener"><span class="icn">💬</span>Zalo</a>
        <a href={localizePath(locale, "/about/")}><span class="icn">ℹ️</span>{dict.about}</a>
      </div>
    </nav>

    <script is:inline>
      // Thu nhỏ header khi scroll xuống, trả lại kích thước bình thường khi ở đầu trang.
      (function () {
        const hdr = document.querySelector(".hdr");
        function onScroll() {
          hdr.classList.toggle("scrolled", window.scrollY > 40);
        }
        onScroll();
        document.addEventListener("scroll", onScroll, { passive: true });
      })();

      // Dark/light toggle
      (function () {
        const btn = document.getElementById("theme-toggle");
        const sun = document.getElementById("icon-sun");
        const moon = document.getElementById("icon-moon");
        function sync() {
          const dark = document.documentElement.dataset.theme === "dark";
          sun.hidden = dark;
          moon.hidden = !dark;
        }
        sync();
        btn.addEventListener("click", function () {
          const isDark = document.documentElement.dataset.theme === "dark";
          if (isDark) {
            delete document.documentElement.dataset.theme;
            localStorage.setItem("theme", "light");
          } else {
            document.documentElement.dataset.theme = "dark";
            localStorage.setItem("theme", "dark");
          }
          sync();
        });
      })();

      // Tìm kiếm sản phẩm — tải index tĩnh 1 lần (theo locale hiện tại), lọc theo tên ngay trên client
      (function () {
        const input = document.getElementById("site-search");
        const results = document.getElementById("search-results");
        if (!input) return;
        const locale = input.dataset.locale || "vi";
        const indexUrl = locale === "vi" ? "/search-index.json" : "/" + locale + "/search-index.json";
        let index = null;
        let loading = null;

        function fmtPrice(amount, currency) {
          if (!amount) return "";
          if (currency === "vnd") return new Intl.NumberFormat("vi-VN").format(Math.round(amount)) + "₫";
          return new Intl.NumberFormat("vi-VN", { style: "currency", currency: currency.toUpperCase() }).format(amount);
        }

        const searchEmptyText = input.dataset.searchEmpty || 'No results for "{q}".';
        const productPrefix = locale === "vi" ? "/products/" : "/" + locale + "/products/";

        function render(items, query) {
          if (items.length === 0) {
            results.innerHTML = '<p class="search-empty">' + searchEmptyText.replace("{q}", query) + "</p>";
          } else {
            results.innerHTML = items
              .slice(0, 8)
              .map(function (p) {
                const thumb = p.thumbnail ? '<img src="' + p.thumbnail + '" alt="" />' : "<span></span>";
                return (
                  '<a href="' + productPrefix + p.handle + '/">' + thumb + "<span>" + p.title + "</span>" +
                  '<span class="price">' + fmtPrice(p.price, p.currency) + "</span></a>"
                );
              })
              .join("");
          }
          results.hidden = false;
        }

        input.addEventListener("input", function () {
          const query = input.value.trim().toLowerCase();
          if (!query) {
            results.hidden = true;
            return;
          }
          if (!index) {
            if (!loading) loading = fetch(indexUrl).then(function (r) { return r.json(); });
            loading.then(function (data) {
              index = data;
              render(
                index.filter(function (p) { return p.title.toLowerCase().includes(query); }),
                query,
              );
            });
            return;
          }
          render(
            index.filter(function (p) { return p.title.toLowerCase().includes(query); }),
            query,
          );
        });
        document.addEventListener("click", function (e) {
          if (!results.contains(e.target) && e.target !== input) results.hidden = true;
        });
      })();

      // Dropdown chọn ngôn ngữ — chỉ toggle hiển thị, các item giờ là <a href> thật (không JS-driven nữa)
      (function () {
        const btn = document.getElementById("lang-btn");
        const menu = document.getElementById("lang-menu");
        btn.addEventListener("click", function () {
          const open = !menu.hidden;
          menu.hidden = open;
          btn.setAttribute("aria-expanded", String(!open));
        });
        document.addEventListener("click", function (e) {
          if (!menu.contains(e.target) && e.target !== btn) menu.hidden = true;
        });
      })();
    </script>
  </body>
</html>
