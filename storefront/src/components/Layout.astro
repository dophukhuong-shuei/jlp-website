---
import "../styles/global.css";
import { site } from "../lib/site";
import { getCategories } from "../lib/medusa";

interface Props {
  title: string;
  description?: string;
  image?: string;
}
const { title, description = site.tagline, image } = Astro.props;
const categories = await getCategories();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://example.com");
const gaId = import.meta.env.PUBLIC_GA_ID as string | undefined;

const CAT_ICONS: Record<string, string> = {
  "Dưỡng da": "🧴",
  "Chống nắng": "☀️",
  "Tẩy trang": "🧼",
  "Trang điểm": "💄",
  "Dưỡng thể": "🧖",
  "Chăm sóc tóc": "💇",
};
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      name: site.name,
      image,
      telephone: site.phone,
      email: site.email,
      address: { "@type": "PostalAddress", streetAddress: site.address, addressCountry: "VN" },
      openingHours: site.hours,
      url: canonicalUrl.origin,
    })} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,400..600,0..100,0..1&family=Be+Vietnam+Pro:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Set theme trước khi CSS/paint để tránh nhấp nháy sáng→tối lúc tải trang.
      (function () {
        const saved = localStorage.getItem("theme");
        const theme = saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        if (theme === "dark") document.documentElement.dataset.theme = "dark";
      })();

      // Mặc định hiển thị tiếng Nhật cho khách lần đầu vào site (chưa từng chọn ngôn ngữ).
      // Khách vẫn đổi được sang VI/EN qua dropdown — lựa chọn đó sẽ được nhớ cho lần sau.
      (function () {
        const hasChosenLang = document.cookie.indexOf("googtrans=") !== -1;
        if (!hasChosenLang) {
          document.cookie = "googtrans=/vi/ja; path=/;";
          document.cookie = "googtrans=/vi/ja; path=/; domain=" + location.hostname + ";";
        }
      })();
    </script>
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag("js", new Date());
          gtag("config", gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <div class="utility">
      <div class="wrap">
        <span>📞 Hotline {site.phone}</span>
        <span>Giao 1–2 ngày nội thành · Đổi hàng lỗi trong 7 ngày</span>
      </div>
    </div>

    <header class="hdr">
      <div class="wrap bar">
        <a class="logo" href="/"><span class="mark">{site.name}</span><span class="ja">{site.nameJa}</span></a>

        <div class="search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          <input type="text" id="site-search" placeholder="Tìm sản phẩm..." autocomplete="off" />
          <div id="search-results" class="search-results" hidden></div>
        </div>

        <div class="hdr-tools">
          <div class="lang-switch">
            <button type="button" id="lang-btn" aria-haspopup="true" aria-expanded="false">🌐 <span id="lang-current">VI</span></button>
            <ul id="lang-menu" hidden>
              <li><button type="button" data-lang="vi">Tiếng Việt</button></li>
              <li><button type="button" data-lang="en">English</button></li>
              <li><button type="button" data-lang="ja">日本語</button></li>
            </ul>
          </div>
          <button type="button" id="theme-toggle" aria-label="Chuyển giao diện sáng/tối">
            <svg id="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><path d="M12 2v2M12 20v2M4 12H2M22 12h-2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <svg id="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" hidden><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z" stroke="currentColor" stroke-width="1.6"/></svg>
          </button>
          <a class="hdr-cta" href={site.zaloUrl} target="_blank" rel="noopener">Chat Zalo</a>
        </div>
      </div>
    </header>

    <nav class="catstrip">
      <div class="wrap">
        {categories.map((c) => (
          <a href={`/categories/${c.handle}/`}><span class="ic">{CAT_ICONS[c.name] ?? "🏷️"}</span>{c.name}</a>
        ))}
        <a href="/promotions/"><span class="ic">🎁</span>Khuyến mãi</a>
        <a href="/#new-arrivals"><span class="ic">✨</span>Hàng mới</a>
      </div>
    </nav>

    <!-- Google Website Translator — widget ẩn UI gốc, điều khiển qua dropdown tuỳ biến ở trên -->
    <div id="google_translate_element" style="display:none"></div>

    <main>
      <slot />
    </main>

    <footer class="ftr">
      <div class="wrap cols">
        <div>
          <p class="eyebrow">Liên hệ</p>
          <p>{site.phone}<br />{site.email}</p>
          <p class="note">{site.address}<br />{site.hours}</p>
        </div>
        <div>
          <p class="eyebrow">Danh mục</p>
          <p class="note">
            {categories.map((c, i) => (
              <>
                <a href={`/categories/${c.handle}/`}>{c.name}</a>
                {i < categories.length - 1 ? " · " : ""}
              </>
            ))}
          </p>
        </div>
        <div>
          <p class="eyebrow">Về hàng hoá</p>
          <p class="note">
            Mọi sản phẩm đều hiển thị mã JAN và số phiếu công bố sản phẩm mỹ phẩm. Bạn có thể quét mã vạch hoặc tra
            số công bố trên cổng thông tin của Cục Quản lý Dược để tự đối chiếu trước khi đặt.
            <br /><a href="/about/">Xem trang giới thiệu →</a>
          </p>
        </div>
      </div>
      <div class="wrap fine data">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span>Website trưng bày sản phẩm — đặt hàng qua Zalo hoặc điện thoại</span>
        <span><a href="/faq/">Câu hỏi thường gặp</a> · <a href="/privacy-policy/">Chính sách bảo mật</a></span>
      </div>
    </footer>

    <div class="dock">
      <span class="response-promise">Phản hồi trong ~15 phút giờ hành chính</span>
      <a class="z" href={site.zaloUrl} target="_blank" rel="noopener">Chat Zalo</a>
      <a class="c" href={site.phoneHref}>{site.phone}</a>
    </div>

    <nav class="mnav">
      <div class="wrap row">
        <a href="/"><span class="icn">🏠</span>Trang chủ</a>
        <a href="/#categories"><span class="icn">📂</span>Danh mục</a>
        <a href="/promotions/"><span class="icn">🎁</span>Khuyến mãi</a>
        <a href={site.zaloUrl} target="_blank" rel="noopener"><span class="icn">💬</span>Zalo</a>
        <a href="/about/"><span class="icn">ℹ️</span>Giới thiệu</a>
      </div>
    </nav>

    <script is:inline>
      // Thu nhỏ header khi scroll xuống, trả lại kích thước bình thường khi ở đầu trang.
      (function () {
        const hdr = document.querySelector(".hdr");
        function onScroll() {
          hdr.classList.toggle("scrolled", window.scrollY > 40);
        }
        onScroll();
        document.addEventListener("scroll", onScroll, { passive: true });
      })();

      // Dark/light toggle
      (function () {
        const btn = document.getElementById("theme-toggle");
        const sun = document.getElementById("icon-sun");
        const moon = document.getElementById("icon-moon");
        function sync() {
          const dark = document.documentElement.dataset.theme === "dark";
          sun.hidden = dark;
          moon.hidden = !dark;
        }
        sync();
        btn.addEventListener("click", function () {
          const isDark = document.documentElement.dataset.theme === "dark";
          if (isDark) {
            delete document.documentElement.dataset.theme;
            localStorage.setItem("theme", "light");
          } else {
            document.documentElement.dataset.theme = "dark";
            localStorage.setItem("theme", "dark");
          }
          sync();
        });
      })();

      // Tìm kiếm sản phẩm — tải index tĩnh 1 lần, lọc theo tên ngay trên client (site tĩnh, không có API runtime)
      (function () {
        const input = document.getElementById("site-search");
        const results = document.getElementById("search-results");
        if (!input) return;
        let index = null;
        let loading = null;

        function fmtPrice(amount, currency) {
          if (!amount) return "";
          if (currency === "vnd") return new Intl.NumberFormat("vi-VN").format(Math.round(amount)) + "₫";
          return new Intl.NumberFormat("vi-VN", { style: "currency", currency: currency.toUpperCase() }).format(amount);
        }

        function render(items, query) {
          if (items.length === 0) {
            results.innerHTML = '<p class="search-empty">Không tìm thấy "' + query + '".</p>';
          } else {
            results.innerHTML = items
              .slice(0, 8)
              .map(function (p) {
                const thumb = p.thumbnail ? '<img src="' + p.thumbnail + '" alt="" />' : "<span></span>";
                return (
                  '<a href="/products/' + p.handle + '/">' + thumb + "<span>" + p.title + "</span>" +
                  '<span class="price">' + fmtPrice(p.price, p.currency) + "</span></a>"
                );
              })
              .join("");
          }
          results.hidden = false;
        }

        input.addEventListener("input", function () {
          const query = input.value.trim().toLowerCase();
          if (!query) {
            results.hidden = true;
            return;
          }
          if (!index) {
            if (!loading) loading = fetch("/search-index.json").then(function (r) { return r.json(); });
            loading.then(function (data) {
              index = data;
              render(
                index.filter(function (p) { return p.title.toLowerCase().includes(query); }),
                query,
              );
            });
            return;
          }
          render(
            index.filter(function (p) { return p.title.toLowerCase().includes(query); }),
            query,
          );
        });
        document.addEventListener("click", function (e) {
          if (!results.contains(e.target) && e.target !== input) results.hidden = true;
        });
      })();

      // Đổi ngôn ngữ — đọc cookie googtrans hiện tại để hiện đúng lựa chọn đang chọn
      (function () {
        const btn = document.getElementById("lang-btn");
        const menu = document.getElementById("lang-menu");
        const current = document.getElementById("lang-current");
        const match = document.cookie.match(/googtrans=\/vi\/(\w+)/);
        const activeLang = match ? match[1] : "vi";
        current.textContent = activeLang.toUpperCase();

        btn.addEventListener("click", function () {
          const open = !menu.hidden;
          menu.hidden = open;
          btn.setAttribute("aria-expanded", String(!open));
        });
        document.addEventListener("click", function (e) {
          if (!menu.contains(e.target) && e.target !== btn) menu.hidden = true;
        });
        menu.querySelectorAll("button[data-lang]").forEach(function (item) {
          item.addEventListener("click", function () {
            const lang = item.dataset.lang;
            const domain = location.hostname;
            if (lang === "vi") {
              document.cookie = "googtrans=/vi/vi; path=/;";
              document.cookie = "googtrans=/vi/vi; path=/; domain=" + domain + ";";
            } else {
              document.cookie = "googtrans=/vi/" + lang + "; path=/;";
              document.cookie = "googtrans=/vi/" + lang + "; path=/; domain=" + domain + ";";
            }
            location.reload();
          });
        });
      })();
    </script>

    <script is:inline>
      function googleTranslateElementInit() {
        new google.translate.TranslateElement(
          { pageLanguage: "vi", includedLanguages: "en,ja", autoDisplay: false },
          "google_translate_element",
        );
      }
    </script>
    <script is:inline src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
  </body>
</html>
