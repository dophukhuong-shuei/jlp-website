---
import { formatPrice } from "../lib/format";
import { getAllProducts, toCatalogItem } from "../lib/medusa";
import { site } from "../lib/site";

const products = await getAllProducts();
const items = products.map(toCatalogItem).filter((i) => i.thumbnail);

const hero = items[0];
const bento = items.slice(1, 6);
const onSale = items.filter((i) => i.onSale).slice(0, 5);

function pct(item: (typeof items)[number]) {
  return item.onSale && item.wasPrice && item.price ? Math.round((1 - item.price / item.wasPrice) * 100) : null;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name} — Genuine Japanese Cosmetics, Traceable Origin</title>
    <meta name="description" content="Genuine Japanese domestic cosmetics, officially imported. Every product shows a JAN code and registration number so you can verify authenticity yourself." />
    <meta property="og:title" content={`${site.name} — Genuine Japanese Cosmetics, Traceable Origin`} />
    <meta property="og:description" content="Genuine Japanese domestic cosmetics, officially imported. Every product shows a JAN code and registration number so you can verify authenticity yourself." />
    {hero?.thumbnail && <meta property="og:image" content={hero.thumbnail} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,500..800,0..100,0..1&family=Be+Vietnam+Pro:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --ink: #14213a;
        --ink-soft: #3d4b66;
        --paper: #fbf8f4;
        --card: #fff;
        --beni: #b0303c;
        --beni-wash: #fdeceb;
        --seal: #2f6551;
        --ochre: #8a7551;
        --gold: #c99a4a;
        --rule: #ece6dd;
        --font-display: "Fraunces", serif;
        --font-body: "Be Vietnam Pro", system-ui, sans-serif;
        --font-label: "IBM Plex Mono", monospace;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--font-body); overflow-x: hidden; }
      h1, h2 { font-family: var(--font-display); font-weight: 600; margin: 0; line-height: 1.08; }
      .wrap { width: min(100% - 2.5rem, 1180px); margin-inline: auto; }
      a { color: inherit; }

      /* hero — tone sáng */
      .lp-hero {
        position: relative;
        min-height: 88vh;
        display: flex;
        align-items: center;
        background:
          radial-gradient(circle at 12% 15%, #fbe3d8 0%, transparent 42%),
          radial-gradient(circle at 88% 10%, #f6d9e0 0%, transparent 40%),
          radial-gradient(circle at 50% 100%, #fef3e7 0%, transparent 55%),
          var(--paper);
        overflow: hidden;
      }
      .lp-hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items: center; }
      .lp-eyebrow {
        font-family: var(--font-label); font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase;
        color: var(--beni); opacity: 0; animation: lpFadeUp 0.6s ease forwards; animation-delay: 0.05s;
      }
      .lp-hero h1 { color: var(--ink); font-size: clamp(2.4rem, 5.5vw, 4.2rem); margin: 0.6rem 0 1.2rem; }
      .lp-hero h1 .word { display: inline-block; opacity: 0; transform: translateY(0.4em); animation: lpFadeUp 0.7s cubic-bezier(.2,.7,.2,1) forwards; }
      .lp-hero em { font-style: italic; color: var(--beni); }
      .lp-hero .lede {
        font-size: 1.15rem; color: var(--ink-soft); max-width: 42ch; margin: 0 0 2rem;
        opacity: 0; animation: lpFadeUp 0.6s ease forwards; animation-delay: 0.55s;
      }
      .lp-hero .cta-row { display: flex; gap: 1rem; flex-wrap: wrap; opacity: 0; animation: lpFadeUp 0.6s ease forwards; animation-delay: 0.7s; }
      .lp-promise { font-size: 0.85rem; color: var(--seal); margin: 1rem 0 0; opacity: 0; animation: lpFadeUp 0.6s ease forwards; animation-delay: 0.8s; }
      @keyframes lpFadeUp { to { opacity: 1; transform: translateY(0); } }

      .lp-btn {
        display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.9rem 1.6rem; border-radius: 999px;
        font-weight: 600; font-size: 0.95rem; text-decoration: none; transition: transform 0.2s;
      }
      .lp-btn:hover { transform: translateY(-2px); }
      .lp-btn.primary { background: var(--beni); color: #fff; box-shadow: 0 0 0 0 rgba(176,48,60,.55); animation: lpPulse 2.6s infinite; }
      .lp-btn.ghost { border: 1px solid var(--ink); color: var(--ink); }
      @keyframes lpPulse {
        0% { box-shadow: 0 0 0 0 rgba(176,48,60,.45); }
        70% { box-shadow: 0 0 0 14px rgba(176,48,60,0); }
        100% { box-shadow: 0 0 0 0 rgba(176,48,60,0); }
      }
      @media (prefers-reduced-motion: reduce) { .lp-btn.primary { animation: none; } }

      .lp-tilt-wrap { perspective: 1200px; }
      .lp-tilt {
        position: relative; border-radius: 18px; overflow: hidden; aspect-ratio: 4/5;
        box-shadow: 0 30px 60px rgba(176,48,60,.18), 0 10px 25px rgba(20,33,58,.12);
        transition: transform .15s ease-out; background: var(--card);
        opacity: 0; animation: lpFadeIn 0.8s ease forwards; animation-delay: 0.3s;
      }
      @keyframes lpFadeIn { to { opacity: 1; } }
      .lp-tilt img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .lp-tilt .badge {
        position: absolute; top: 1rem; left: 1rem; background: #fff; color: var(--beni); font-family: var(--font-label);
        font-size: 0.75rem; font-weight: 700; padding: 0.35rem 0.7rem; border-radius: 999px; box-shadow: 0 4px 12px rgba(0,0,0,.1);
      }
      .lp-tilt .price-tag {
        position: absolute; bottom: 1rem; left: 1rem; right: 1rem; background: rgba(255,255,255,.92);
        backdrop-filter: blur(4px); border-radius: 12px; padding: .7rem .9rem; display: flex; flex-direction: column; gap: .1rem;
      }
      .lp-tilt .price-tag .b { font-family: var(--font-label); font-size: .68rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ochre); }
      .lp-tilt .price-tag .n { font-size: .92rem; font-weight: 600; color: var(--ink); }
      .lp-tilt .price-tag .p { font-family: var(--font-label); font-weight: 700; color: var(--beni); font-size: 1.05rem; }
      /* hiệu ứng lấp lánh quét qua ảnh */
      .lp-tilt::before {
        content: ""; position: absolute; inset: 0; z-index: 2; pointer-events: none;
        background: linear-gradient(115deg, transparent 30%, rgba(255,255,255,.55) 48%, transparent 66%);
        transform: translateX(-120%); animation: lpShine 3.2s ease-in-out infinite; animation-delay: 1.2s;
      }
      @keyframes lpShine { to { transform: translateX(120%); } }
      @media (prefers-reduced-motion: reduce) { .lp-tilt::before { animation: none; } }

      /* marquee — tone sáng */
      .lp-marquee-wrap { background: var(--beni-wash); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); overflow: hidden; padding: 1rem 0; }
      .lp-marquee { display: flex; gap: 3rem; width: max-content; animation: lpScroll 24s linear infinite; }
      .lp-marquee span { color: var(--beni); font-family: var(--font-label); font-weight: 600; font-size: 0.85rem; letter-spacing: 0.05em; white-space: nowrap; }
      @keyframes lpScroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
      @media (prefers-reduced-motion: reduce) { .lp-marquee { animation: none; } }

      /* bento */
      .lp-section { padding: clamp(3rem, 7vw, 5.5rem) 0; }
      .lp-head { text-align: center; max-width: 46ch; margin: 0 auto 2.5rem; }
      .lp-head .lp-eyebrow2 { font-family: var(--font-label); font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ochre); }
      .lp-head h2 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); margin: 0.5rem 0 0; }

      .lp-bento { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 220px; grid-auto-flow: dense; gap: 1.1rem; }
      .lp-card {
        position: relative; border-radius: 16px; overflow: hidden; grid-column: span 1; grid-row: span 1;
        background: var(--card); box-shadow: 0 2px 10px rgba(20,33,58,.06); transition: transform .3s ease, box-shadow .3s ease;
        display: flex; flex-direction: column;
      }
      .lp-card:hover { transform: translateY(-6px); box-shadow: 0 18px 32px rgba(176,48,60,.16); }
      .lp-bento.feature .lp-card:first-child { grid-column: span 2; grid-row: span 2; }
      .lp-card .media { position: relative; flex: 1; overflow: hidden; background: var(--paper); }
      .lp-card img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease; }
      .lp-card:hover img { transform: scale(1.07); }
      .lp-card .pct-badge {
        position: absolute; top: .6rem; left: .6rem; background: var(--beni); color: #fff; font-family: var(--font-label);
        font-size: .7rem; font-weight: 700; padding: .25rem .5rem; border-radius: 999px; z-index: 1;
      }
      .lp-card .gift-badge {
        position: absolute; top: .6rem; right: .6rem; background: var(--seal); color: #fff; font-family: var(--font-label);
        font-size: .65rem; font-weight: 700; padding: .25rem .5rem; border-radius: 999px; z-index: 1;
      }
      .lp-card .info { padding: .7rem .8rem .85rem; }
      .lp-card .brand { font-family: var(--font-label); font-size: .65rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ochre); margin: 0 0 .15rem; }
      .lp-card .name { font-size: .85rem; font-weight: 600; margin: 0 0 .3rem; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
      .lp-card:first-child .name { -webkit-line-clamp: 2; font-size: 1rem; }
      .lp-card .prices { display: flex; align-items: baseline; gap: .4rem; font-family: var(--font-label); }
      .lp-card .now { color: var(--beni); font-weight: 700; font-size: .88rem; }
      .lp-card .was { color: #9aa3b4; font-size: .72rem; text-decoration: line-through; }
      @media (max-width: 800px) { .lp-bento { grid-template-columns: repeat(2, 1fr); } .lp-card:first-child { grid-column: span 2; } }

      /* reveal on scroll */
      .lp-reveal { opacity: 0; transform: translateY(24px); transition: opacity .6s ease, transform .6s ease; }
      .lp-reveal.in { opacity: 1; transform: translateY(0); }

      .lp-why { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
      .lp-why-item { text-align: center; padding: 1.5rem 1rem; border-radius: 14px; background: var(--card); box-shadow: 0 2px 10px rgba(20,33,58,.05); }
      .lp-why-item .icn { font-size: 2rem; margin-bottom: 0.75rem; }
      .lp-why-item h3 { font-size: 1.05rem; margin: 0 0 0.4rem; font-family: var(--font-display); }
      .lp-why-item p { margin: 0; font-size: 0.88rem; color: var(--ink-soft); }
      @media (max-width: 800px) { .lp-why { grid-template-columns: repeat(2, 1fr); } }

      /* final cta — tone sáng */
      .lp-final {
        position: relative; border-radius: 20px; overflow: hidden; padding: clamp(3rem, 6vw, 5rem) 2rem; text-align: center;
        background: radial-gradient(circle at 25% 25%, #fbe3d8 0%, transparent 50%), radial-gradient(circle at 80% 80%, #f6d9e0 0%, transparent 45%),
          var(--card);
        border: 1px solid var(--rule);
      }
      .lp-final h2 { color: var(--ink); font-size: clamp(1.8rem, 4vw, 2.8rem); margin-bottom: 1rem; }
      .lp-final p { color: var(--ink-soft); margin: 0 0 2rem; }

      .lp-footer { text-align: center; padding: 2rem 0; font-family: var(--font-label); font-size: 0.78rem; color: #9aa3b4; }
    </style>
  </head>
  <body>
    <section class="lp-hero">
      <div class="wrap lp-hero-grid">
        <div>
          <p class="lp-eyebrow">Japanese domestic goods · Officially imported</p>
          <h1>
            <span class="word" style="animation-delay:.12s">Japanese&nbsp;</span>
            <span class="word" style="animation-delay:.2s">cosmetics,&nbsp;</span>
            <br />
            <em><span class="word" style="animation-delay:.38s">traceable&nbsp;</span>
            <span class="word" style="animation-delay:.46s">to&nbsp;</span>
            <span class="word" style="animation-delay:.54s">the&nbsp;</span>
            <span class="word" style="animation-delay:.62s">source.</span></em>
          </h1>
          <p class="lede">
            Every product carries a JAN code and an official registration number so you can verify it yourself —
            not unverifiable grey-market goods.
          </p>
          <div class="cta-row">
            <a class="lp-btn primary" href="/">Shop now →</a>
            <a class="lp-btn ghost" href={site.zaloUrl} target="_blank" rel="noopener">Chat on Zalo</a>
          </div>
          <p class="lp-promise">💬 We reply within ~15 minutes during business hours</p>
        </div>
        <div class="lp-tilt-wrap">
          <div class="lp-tilt" id="tilt-card">
            {hero?.thumbnail && <img src={hero.thumbnail} alt={hero.title} />}
            <span class="badge">✨ Best seller</span>
            {hero && (
              <div class="price-tag">
                {hero.brand && <span class="b">{hero.brand}</span>}
                <span class="n">{hero.title}</span>
                {hero.price != null && <span class="p">{formatPrice(hero.price, hero.currency)}</span>}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    <div class="lp-marquee-wrap">
      <div class="lp-marquee">
        {Array.from({ length: 2 }).map(() => (
          <>
            <span>✦ OFFICIALLY IMPORTED</span>
            <span>✦ VERIFIABLE JAN CODE</span>
            <span>✦ FAST LOCAL DELIVERY</span>
            <span>✦ 7-DAY EXCHANGE</span>
            <span>✦ ORDER VIA ZALO</span>
          </>
        ))}
      </div>
    </div>

    <section class="lp-section">
      <div class="wrap">
        <div class="lp-head lp-reveal">
          <p class="lp-eyebrow2">Products</p>
          <h2>Customer favorites</h2>
        </div>
        <div class="lp-bento feature lp-reveal">
          {bento.map((item) => (
            <a class="lp-card" href={`/products/${item.handle}/`}>
              <div class="media">
                {pct(item) && <span class="pct-badge">-{pct(item)}%</span>}
                {item.gift && <span class="gift-badge">🎁</span>}
                {item.thumbnail && <img src={item.thumbnail} alt={item.title} />}
              </div>
              <div class="info">
                {item.brand && <p class="brand">{item.brand}</p>}
                <p class="name">{item.title}</p>
                <p class="prices">
                  {item.price != null && <span class="now">{formatPrice(item.price, item.currency)}</span>}
                  {item.wasPrice != null && <span class="was">{formatPrice(item.wasPrice, item.currency)}</span>}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="lp-section" style="background:var(--card)">
      <div class="wrap">
        <div class="lp-head lp-reveal">
          <p class="lp-eyebrow2">Why choose {site.name}</p>
          <h2>Not unverifiable grey-market goods</h2>
        </div>
        <div class="lp-why lp-reveal">
          <div class="lp-why-item">
            <div class="icn">🔎</div>
            <h3>Verify the real JAN code</h3>
            <p>Check it directly against the code printed on the box</p>
          </div>
          <div class="lp-why-item">
            <div class="icn">📄</div>
            <h3>Official registration number</h3>
            <p>Looked up on the Drug Administration's own portal</p>
          </div>
          <div class="lp-why-item">
            <div class="icn">🚚</div>
            <h3>1–2 day delivery</h3>
            <p>Local delivery, carefully packaged</p>
          </div>
          <div class="lp-why-item">
            <div class="icn">💬</div>
            <h3>Zalo advice</h3>
            <p>Get matched to the right skin type and needs</p>
          </div>
        </div>
      </div>
    </section>

    {onSale.length > 0 && (
      <section class="lp-section">
        <div class="wrap">
          <div class="lp-head lp-reveal">
            <p class="lp-eyebrow2">Deals</p>
            <h2>On sale now</h2>
          </div>
          <div class="lp-bento lp-reveal" style="grid-auto-rows:260px">
            {onSale.map((item) => (
              <a class="lp-card" href={`/products/${item.handle}/`}>
                <div class="media">
                  {pct(item) && <span class="pct-badge">-{pct(item)}%</span>}
                  {item.gift && <span class="gift-badge">🎁</span>}
                  {item.thumbnail && <img src={item.thumbnail} alt={item.title} />}
                </div>
                <div class="info">
                  {item.brand && <p class="brand">{item.brand}</p>}
                  <p class="name">{item.title}</p>
                  <p class="prices">
                    {item.price != null && <span class="now">{formatPrice(item.price, item.currency)}</span>}
                    {item.wasPrice != null && <span class="was">{formatPrice(item.wasPrice, item.currency)}</span>}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="lp-section">
      <div class="wrap">
        <div class="lp-final lp-reveal">
          <h2>Ready to explore?</h2>
          <p>Browse the full catalog, filter by category and promotions on the main site.</p>
          <a class="lp-btn primary" href="/">Go to the shop →</a>
        </div>
      </div>
    </section>

    <p class="lp-footer">© {new Date().getFullYear()} {site.name} — Catalog site, order via Zalo or phone</p>

    <script>
      const tilt = document.getElementById("tilt-card");
      if (tilt) {
        tilt.addEventListener("mousemove", (e) => {
          const r = tilt.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          tilt.style.transform = `rotateY(${x * 14}deg) rotateX(${-y * 14}deg)`;
        });
        tilt.addEventListener("mouseleave", () => {
          tilt.style.transform = "rotateY(0) rotateX(0)";
        });
      }

      const revealEls = document.querySelectorAll(".lp-reveal");
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      revealEls.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
