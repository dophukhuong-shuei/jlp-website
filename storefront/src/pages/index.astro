---
import Layout from "../components/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { getAllProducts, getCategories, medusa, toCatalogItem } from "../lib/medusa";
import { site } from "../lib/site";

const products = await getAllProducts();
const items = products.map(toCatalogItem);
const featured = items.filter((i) => i.thumbnail).slice(0, 8);
const showcaseImages = items.filter((i) => i.thumbnail).slice(0, 4);
const promoImage = items.find((i) => i.thumbnail)?.thumbnail;

const onSaleItems = items.filter((i) => i.onSale || i.gift).slice(0, 8);
const newestItems = [...items]
  .sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime())
  .slice(0, 8);

const categories = await getCategories();
const categoryCards = await Promise.all(
  categories.map(async (c) => {
    const { count, products: sample } = await medusa.store.product.list({
      category_id: c.id,
      limit: 1,
      fields: "thumbnail",
    });
    return { ...c, count, thumbnail: sample[0]?.thumbnail ?? null };
  }),
);
---

<Layout
  title={`${site.name} — Catalog mỹ phẩm Nhật`}
  description="Mỹ phẩm nội địa Nhật nhập chính ngạch, tra được mã JAN và số phiếu công bố. Đặt hàng qua Zalo hoặc điện thoại, giao 1–2 ngày nội thành."
  image={showcaseImages[0]?.thumbnail}
>
  <section class="campaign">
    <div class="wrap">
      <div class="campaign-main">
        {showcaseImages[0]?.thumbnail && <img src={showcaseImages[0].thumbnail} alt="" />}
        <div class="cap">
          <p class="eyebrow">Hàng nội địa Nhật · Nhập chính ngạch</p>
          <h1>Mỗi sản phẩm đều có mã JAN để đối chiếu</h1>
          <a class="cta-primary" href="#verify">Xem cách kiểm tra hàng thật</a>
        </div>
      </div>
      <div class="campaign-side">
        <a href="/promotions/">
          {onSaleItems[0]?.thumbnail && <img src={onSaleItems[0].thumbnail} alt="" />}
          <span class="cap">Đang khuyến mãi</span>
        </a>
        <a class="b" href="#new-arrivals">
          {newestItems[0]?.thumbnail && <img src={newestItems[0].thumbnail} alt="" />}
          <span class="cap">Hàng mới về tuần này</span>
        </a>
      </div>
    </div>
  </section>

  <section class="badges">
    <div class="wrap">
      <div class="badge">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z" stroke="currentColor" stroke-width="1.6"/></svg>
        <span><strong>Hàng chính ngạch</strong>Tra được mã JAN, phiếu công bố</span>
      </div>
      <div class="badge">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span><strong>Giao nhanh nội thành</strong>1–2 ngày ở TP.HCM</span>
      </div>
      <div class="badge">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span><strong>Đặt hàng qua Zalo</strong>Không thanh toán online</span>
      </div>
      <div class="badge">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <span><strong>Đổi hàng lỗi</strong>Trong 7 ngày nhận hàng</span>
      </div>
    </div>
  </section>

  <section class="block" id="categories">
    <div class="wrap">
      <div class="sec-head">
        <h2>Danh mục</h2>
        <p class="eyebrow">{categories.length} nhóm sản phẩm</p>
      </div>
      <div class="grid">
        {categoryCards.map((c) => (
          <a class="cat-card" href={`/categories/${c.handle}/`}>
            {c.thumbnail && <img src={c.thumbnail} alt={c.name} />}
            <div class="cat-label">
              <h3>{c.name}</h3>
              <p class="data">{c.count} sản phẩm</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="block" id="featured">
    <div class="wrap">
      <div class="sec-head">
        <h2>Sản phẩm nổi bật</h2>
        <a class="more" href="/categories/trang-điểm/">Xem theo danh mục →</a>
      </div>
      <div class="grid">
        {featured.map((item) => (
          <ProductCard item={item} />
        ))}
      </div>
    </div>
  </section>

  {onSaleItems.length > 0 && (
    <section class="block">
      <div class="wrap">
        <div class="sec-head">
          <h2>Đang khuyến mãi</h2>
          <a class="more" href="/promotions/">Xem tất cả khuyến mãi →</a>
        </div>
        <div class="grid">
          {onSaleItems.map((item) => (
            <ProductCard item={item} />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="block">
    <div class="wrap">
      <div class="promo">
        {promoImage && <img src={promoImage} alt="" />}
        <div class="promo-body">
          <p class="eyebrow" style="color:color-mix(in srgb,#fff 70%,transparent)">Về {site.name}</p>
          <h2>Mỹ phẩm Nhật, tra cứu được nguồn gốc</h2>
          <p>{site.about}</p>
          <a class="cta-primary" href="/about/">Xem trang giới thiệu</a>
        </div>
      </div>
    </div>
  </section>

  <section class="block" id="new-arrivals">
    <div class="wrap">
      <div class="sec-head">
        <h2>Hàng mới về</h2>
        <p class="eyebrow">Cập nhật gần nhất</p>
      </div>
      <div class="grid">
        {newestItems.map((item) => (
          <ProductCard item={item} />
        ))}
      </div>
    </div>
  </section>

  <section class="block" id="verify">
    <div class="wrap">
      <div class="sec-head"><h2>Cách tự kiểm tra hàng thật</h2></div>
      <ol class="steps">
        <li>
          <span class="n">01</span>
          <h3>Quét mã JAN trên vỏ hộp</h3>
          <p>Mã 13 số in dưới barcode phải khớp với mã ghi trên trang sản phẩm. Lệch một số là hàng không cùng lô nhập.</p>
        </li>
        <li>
          <span class="n">02</span>
          <h3>Đối chiếu số phiếu công bố</h3>
          <p>Mỗi sản phẩm nhập hợp pháp đều có phiếu công bố sản phẩm mỹ phẩm. Số này tra được trên cổng thông tin của Cục Quản lý Dược.</p>
        </li>
        <li>
          <span class="n">03</span>
          <h3>Kiểm tra mã lô và hạn dùng</h3>
          <p>Mã lô dập nổi ở đáy hộp, không phải dán decal. Hạn dùng còn tối thiểu 12 tháng khi hàng đến tay bạn.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Cần tư vấn chọn sản phẩm?</h2>
          <p>Chat Zalo để được hỗ trợ chọn đúng loại da, đúng nhu cầu — phản hồi trong giờ làm việc.</p>
        </div>
        <a class="cta-primary" href={site.zaloUrl} target="_blank" rel="noopener">Chat Zalo ngay</a>
      </div>
    </div>
  </section>
</Layout>
